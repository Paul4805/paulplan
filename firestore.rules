rules_version = '2';

// Slot — every document is owned by exactly one user. There are no shared or
// public documents in v1. The default is deny: anything not matched below is
// unreachable.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Every content write must stamp updatedAt with the server timestamp. This
    // is what the clients rely on for ordering, and it stops a client from
    // back-dating or forging a write time.
    function touched() {
      return request.resource.data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /meta/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && touched()
          && request.resource.data.timezone is string
          && request.resource.data.schemaVersion is int;
      }

      match /subjects/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && touched()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.color in ['indigo', 'sky', 'violet', 'amber', 'rose', 'emerald']
          && request.resource.data.archived is bool;
      }

      match /classes/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && touched()
          && request.resource.data.dayOfWeek is int
          && request.resource.data.dayOfWeek >= 1
          && request.resource.data.dayOfWeek <= 7
          && request.resource.data.startMinutes is int
          && request.resource.data.startMinutes >= 0
          && request.resource.data.startMinutes < 1440
          && request.resource.data.endMinutes is int
          && request.resource.data.endMinutes > request.resource.data.startMinutes
          && request.resource.data.endMinutes <= 1440
          // A timetable entry is either a class (linked to a subject) or a
          // free-standing event (talks, meetings, church…) with a title.
          && (
               (request.resource.data.subjectId is string && request.resource.data.subjectId.size() > 0)
               || (request.resource.data.title is string
                   && request.resource.data.title.size() > 0
                   && request.resource.data.title.size() <= 80)
             )
          && (
               !('colorOverride' in request.resource.data)
               || request.resource.data.colorOverride in ['indigo', 'sky', 'violet', 'amber', 'rose', 'emerald']
             );
      }

      match /tasks/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && touched()
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.status in ['todo', 'doing', 'done']
          && request.resource.data.priority in ['low', 'medium', 'high'];
      }

      match /studySessions/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && touched()
          && request.resource.data.durationMinutes is int
          && request.resource.data.durationMinutes >= 0
          && request.resource.data.durationMinutes <= 1440
          && request.resource.data.startedAt is timestamp
          && request.resource.data.endedAt is timestamp
          && request.resource.data.source in ['pomodoro', 'manual'];
      }

      match /alarms/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && touched()
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.kind in ['class', 'task', 'custom']
          && request.resource.data.recurrence in ['weekly', 'daily', 'once']
          && request.resource.data.enabled is bool
          && request.resource.data.leadMinutes is int
          && request.resource.data.leadMinutes >= 0
          && request.resource.data.leadMinutes <= 1440
          && request.resource.data.timezone is string;
      }

      // Physical training: runs (manual or imported from a Strava export),
      // football, gym, anything else that is not academic study.
      match /ptSessions/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && touched()
          && request.resource.data.type in ['run', 'football', 'gym', 'other']
          && request.resource.data.source in ['manual', 'strava-csv']
          && request.resource.data.startedAt is timestamp
          && request.resource.data.durationMinutes is int
          && request.resource.data.durationMinutes >= 0
          && request.resource.data.durationMinutes <= 1440
          && (
               !('distanceKm' in request.resource.data)
               || request.resource.data.distanceKm == null
               || (request.resource.data.distanceKm is number && request.resource.data.distanceKm >= 0)
             );
      }      // Sparse user actions on fired alarms. Created only when a user snoozes or
      // dismisses; never pre-materialised (there are no Cloud Functions).
      match /alarmState/{eventId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.state in ['snoozed', 'dismissed']
          && request.resource.data.actedAt == request.time
          && request.resource.data.alarmId is string
          && request.resource.data.alarmId.size() > 0;
      }
    }
  }
}
