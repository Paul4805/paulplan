      "indigo": "#6366F1",
      "sky": "#0284C7",
      "violet": "#7C3AED",
      "amber": "#B45309",
      "rose": "#E11D48",
      "emerald": "#047857"
    },
    "dark": {
      "indigo": "#818CF8",
      "sky": "#38BDF8",
      "violet": "#A78BFA",
      "amber": "#FBBF24",
      "rose": "#FB7185",
      "emerald": "#34D399"
    }
  },

  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },

  "radius": {
    "chip": 8,
    "card": 12,
    "sheet": 16,
    "pill": 999
  },

  "type": {
    "xs": { "size": 12, "line": 16 },
    "sm": { "size": 13, "line": 18 },
    "base": { "size": 14, "line": 20 },
    "md": { "size": 16, "line": 24 },
    "lg": { "size": 20, "line": 28 },
    "xl": { "size": 24, "line": 32 },
    "xxl": { "size": 30, "line": 36 },
    "display": { "size": 36, "line": 44 }
  },

  "weight": {
    "regular": 400,
    "medium": 500,
    "semibold": 600
  },

  "motion": {
    "fast": 150,
    "base": 200,
    "easing": [0.2, 0, 0, 1]
  },

  "elevation": {
    "popover": "0 1px 2px rgba(0, 0, 0, 0.04)",
    "modal": "0 8px 24px rgba(0, 0, 0, 0.08)"
  },

  "font": {
    "sans": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
