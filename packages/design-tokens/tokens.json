{
  "meta": {
    "version": 1,
    "note": "Single source of truth for web and Android. Generated artefacts are gitignored; never edit them by hand. #6366F1 is the brand swatch. Interactive text and filled buttons use the darker accent values so they clear 4.5:1 against the canvas."
  },

