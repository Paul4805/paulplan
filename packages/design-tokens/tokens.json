      "textMuted": "#71717A",
      "accent": "#6366F1",
      "accentText": "#4F46E5",
      "accentSolid": "#4F46E5",
      "accentSolidHover": "#4338CA",
      "accentSubtle": "#EEF2FF",
      "accentFg": "#FFFFFF",
      "success": "#15803D",
      "warning": "#B45309",
      "danger": "#B91C1C",
      "focusRing": "#6366F1"
    },
    "dark": {
      "canvas": "#0B0B0F",
      "surface": "#141419",
      "surfaceElevated": "#1B1B22",
      "border": "#26262E",
      "borderStrong": "#3F3F46",
      "textPrimary": "#F4F4F5",
      "textSecondary": "#A1A1AA",
      "textMuted": "#71717A",
      "accent": "#818CF8",
